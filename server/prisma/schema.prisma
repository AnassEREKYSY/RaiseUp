generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ─── ENUMS ───────────────────────────────────────────────────────────────
//

enum Role {
  STARTUP
  INVESTOR
  ADMIN
}

enum Stage {
  IDEA
  MVP
  GROWTH
  SCALE
  EXIT
}

enum Industry {
  FINTECH
  HEALTHCARE
  EDUCATION
  ECOMMERCE
  AI
  BLOCKCHAIN
  GREEN_TECH
  LOGISTICS
  AGRITECH
  OTHER
}

enum MatchStatus {
  PENDING
  ACCEPTED
  REJECTED
}

//
// ─── MODELS ───────────────────────────────────────────────────────────────
//

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  fullName  String
  avatarUrl String?
  role      Role     @default(STARTUP)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  startupProfile  StartupProfile?
  investorProfile InvestorProfile?
  messages        Message[]        @relation("UserMessages")
  sentMatches     Match[]          @relation("StartupMatches")
  receivedMatches Match[]          @relation("InvestorMatches")
  notifications   Notification[]
  pipelineItems   PipelineItem[]
  profileViews    ProfileView[]
  readMarks       MatchRead[]
}

model StartupProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  companyName   String
  description   String?
  industry      Industry
  stage         Stage
  fundingNeeded Float?
  teamSize      Int?
  website       String?
  country       String?
  traction      String?
  pitchDeckUrl  String?
  createdAt     DateTime @default(now())
  // Added in v2
  tagline       String?
  amountRaised  Float?
  foundedYear   Int?
  monthlyRevenue Float?
  monthlyGrowth Float? // percent
  customers     Int?
  updatedAt     DateTime @default(now()) @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  projects      Project[]
  pipelineItems PipelineItem[]
}

model InvestorProfile {
  id              String     @id @default(cuid())
  userId          String     @unique
  companyName     String?
  investmentRange String?
  industries      Industry[]
  location        String?
  stagePreference Stage[]
  website         String?
  bio             String?
  createdAt       DateTime   @default(now())
  // Added in v2
  investorType    String? // ANGEL | VC | CORPORATE | FAMILY_OFFICE | ACCELERATOR
  minTicket       Float?
  maxTicket       Float?
  portfolioCount  Int?
  updatedAt       DateTime   @default(now()) @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  matches Match[] @relation("InvestorProfileMatches")
}

model Project {
  id          String   @id @default(cuid())
  startupId   String
  title       String
  description String
  fundingGoal Float?
  industry    Industry
  createdAt   DateTime @default(now())

  startup StartupProfile @relation(fields: [startupId], references: [id])
  matches Match[]
}

model Match {
  id                String      @id @default(cuid())
  startupId         String
  investorId        String
  projectId         String?
  investorProfileId String?
  status            MatchStatus @default(PENDING)
  createdAt         DateTime    @default(now())
  // Added in v2
  requestedById     String?
  respondedAt       DateTime?
  lastMessageAt     DateTime?

  startup         User             @relation("StartupMatches", fields: [startupId], references: [id], map: "fk_match_startup_user")
  investor        User             @relation("InvestorMatches", fields: [investorId], references: [id], map: "fk_match_investor_user")
  investorProfile InvestorProfile? @relation("InvestorProfileMatches", fields: [investorProfileId], references: [id], map: "fk_match_investor_profile")
  project         Project?         @relation(fields: [projectId], references: [id])
  messages        Message[]
  reads           MatchRead[]

  @@index([startupId])
  @@index([investorId])
}

model Message {
  id        String   @id @default(cuid())
  matchId   String
  senderId  String
  content   String
  createdAt DateTime @default(now())
  // Added in v2: TEXT or MEETING (meeting holds { slots: string[], note?, acceptedSlot?, status })
  kind      String   @default("TEXT")
  meta      Json?

  match  Match @relation(fields: [matchId], references: [id])
  sender User  @relation("UserMessages", fields: [senderId], references: [id])

  @@index([matchId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  link      String? // added in v2: where the notification leads in the app

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// ─── Added in v2 ───────────────────────────────────────────────────────────

// Last time a participant opened a conversation (drives unread counts).
model MatchRead {
  matchId String
  userId  String
  readAt  DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([matchId, userId])
}

// An investor's private deal board.
model PipelineItem {
  id        String   @id @default(cuid())
  userId    String
  startupId String
  stage     String   @default("INTERESTED") // INTERESTED | CONTACTED | MEETING | DUE_DILIGENCE | INVESTED | PASSED
  notes     String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  startup StartupProfile @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@unique([userId, startupId])
  @@index([userId, stage])
}

// One row per profile visit (deduplicated per viewer and day in code).
model ProfileView {
  id          String   @id @default(cuid())
  viewerId    String
  profileType String // STARTUP | INVESTOR
  profileId   String
  createdAt   DateTime @default(now())

  viewer User @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@index([profileType, profileId, createdAt])
}
